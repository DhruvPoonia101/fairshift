# Copy to .env for local use. Never commit real values.

PORT=8080
NODE_ENV=development

# Demo mode lets anyone log in with one click (POST /api/demo-login/:role).
# SET THIS TO false IN PRODUCTION.
DEMO_MODE=true

# Required for real employer login when DEMO_MODE=false. Leave empty to disable.
ADMIN_PASSWORD=

# Signs session cookies and QR tokens. If empty, a random value is generated at boot
# (sessions then reset on every restart and differ between instances).
SESSION_SECRET=

# Optional: Gemini summary of anonymous feedback themes. Falls back to a rule-based counter.
GEMINI_API_KEY=
GEMINI_MODEL=
